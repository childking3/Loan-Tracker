# Production template for the two app nodes. The file is mirrored between
# the nodes by lsyncd, so every value must mean the same thing on both
# (127.0.0.1 = "this node's own"). Install as /var/www/loan-management/
# protected/.env with owner root:loanapp and mode 640 (no ACLs needed).
# NEVER put the real values in git.

APP_ENV=prod
APP_DEBUG=false
APP_HOST_INFO=https://dmcmanagement.duckdns.org
# Both proxies' WireGuard ranges, as seen by the app nodes.
TRUSTED_PROXY_CIDRS=10.10.10.0/24,10.10.2.0/24

# Sessions and logs live in tmpfs, outside the mirrored tree.
RUNTIME_PATH=/run/loan-app

# Each node writes to its own local Galera member; Galera replicates.
DB_DSN=mysql:host=127.0.0.1;dbname=loantracker
DB_USER=loantracker
DB_PASSWORD=__GENERATE__

# Dedicated local loan KeyDB on each node (not HumHub's 6380 instance); no password, 127.0.0.1 only.
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_DATABASE=0

COOKIE_VALIDATION_KEY=__GENERATE_32+_RANDOM_CHARS__
