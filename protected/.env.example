# Copy this file to protected/.env and fill in real values.
# protected/.env is denied at the web-server level (see protected/.htaccess
# and the Apache <Directory> block) — never move it outside protected/.

APP_ENV=dev
# Keep this false against any real, reachable deployment. Setting it true
# wires yii\'s YII_DEBUG constant on (see index.php), which makes Yii2's
# own bootstrap-level error pages show full stack traces, file paths, and
# config values to whoever triggers them - only ever flip this true for
# deliberate, local-only debugging, and back to false immediately after.
APP_DEBUG=false

# The scheme+host (+ non-default port) this deployment is actually served
# on, e.g. https://loans.example.com. Used to pin yii\web\Request::$hostInfo
# so every absolute URL the app generates (redirects included) uses this
# fixed value instead of trusting the incoming Host header. Always set this
# to the real, final host - never leave it unset in a real deployment.
APP_HOST_INFO=http://127.0.0.1

# If this deployment sits behind a reverse proxy, a comma-separated list
# of CIDR blocks (or bare IPs, treated as /32) it may run on, e.g.
# 10.10.2.0/24,10.10.10.0/24 - X-Forwarded-For/X-Forwarded-Proto are only
# trusted from inside one of these. Leave blank if there is no reverse
# proxy (nothing is trusted then, which is the safe default).
TRUSTED_PROXY_CIDRS=

DB_DSN=mysql:host=127.0.0.1;dbname=loantracker
DB_USER=loantracker
DB_PASSWORD=changeme

# KeyDB / Redis-compatible cache. Local dev default port is 6379 (the KeyDB
# stock default); this is NOT the 6380 used on the separate lab VPS box.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0

COOKIE_VALIDATION_KEY=changeme-generate-a-random-32+char-string
